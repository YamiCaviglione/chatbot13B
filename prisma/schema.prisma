generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // o "sqlite"
  url      = env("DATABASE_URL")
}

enum Priority {
  low
  medium
  high
}

model Task {
  id          String    @id @default(uuid())
  title       String
  completed   Boolean   @default(false)
  priority    Priority  @default(medium)
  category    String?
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?
  userId      String    // NUEVO CAMPO
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade) // NUEVA RELACIÓN
}

//modelo de Usuario
model User {
  id              String    @id @default(uuid())
  email           String    @unique
  name            String
  hashedPassword  String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  tasks           Task[]
  preferences     UserPreferences?
}

//modelo de preferencias de usuario
model UserPreferences {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  capitalizeTasks Boolean  @default(false)
  refreshInterval Int      @default(60)
  theme           String   @default("light")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
